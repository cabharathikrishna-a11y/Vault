rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMember(memberUids) {
      return isAuthenticated() && request.auth.uid in memberUids;
    }

    function isValidFamily(data) {
      return data.id is string &&
             data.name is string && data.name.size() > 0 &&
             data.createdBy is string &&
             data.memberUids is list &&
             data.salt is string &&
             data.keyCheckHash is string;
    }

    function isValidVaultItem(data) {
      return data.id is string &&
             data.familyId is string &&
             data.isPrivate is bool &&
             data.itemType in ['password', 'document', 'id_card', 'note', 'bank'] &&
             data.encryptedTitle is string &&
             data.encryptedPayload is string &&
             data.createdByUid is string &&
             data.memberUids is list;
    }

    function isValidPasswordHistory(data) {
      return data.id is string &&
             data.familyId is string &&
             data.encryptedPassword is string &&
             data.length is int &&
             data.generatedByUid is string &&
             data.generatedByName is string &&
             data.memberUids is list;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.email is string;
    }

    // Family Vault metadata
    match /families/{familyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.auth.uid in request.resource.data.memberUids &&
        isValidFamily(request.resource.data);
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.memberUids ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
         request.auth.uid in request.resource.data.memberUids)
      ) && isValidFamily(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;

      // Shared Family Items (Passwords, Aadhaar, IDs, Documents)
      match /vault_items/{itemId} {
        allow read: if isAuthenticated() && isMember(resource.data.memberUids);
        allow create: if isAuthenticated() &&
          request.resource.data.createdByUid == request.auth.uid &&
          isMember(request.resource.data.memberUids) &&
          isValidVaultItem(request.resource.data);
        allow update: if isAuthenticated() &&
          isMember(resource.data.memberUids) &&
          isMember(request.resource.data.memberUids) &&
          isValidVaultItem(request.resource.data);
        allow delete: if isAuthenticated() && isMember(resource.data.memberUids);
      }

      // Password generation history synced across family
      match /password_history/{historyId} {
        allow read: if isAuthenticated() && isMember(resource.data.memberUids);
        allow create: if isAuthenticated() &&
          request.resource.data.generatedByUid == request.auth.uid &&
          isMember(request.resource.data.memberUids) &&
          isValidPasswordHistory(request.resource.data);
        allow update: if false;
        allow delete: if isAuthenticated() && isMember(resource.data.memberUids);
      }
    }

    // User Profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Private items for individual user only
      match /private_items/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
